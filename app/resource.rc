#include <windows.h>

// Named GLFW_ICON so the GLFW backend uses the same icon
// resource for the window title bar / taskbar as the EXE.
GLFW_ICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Admenri Adev"
            VALUE "FileDescription", "Lime RGSS Runtime"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductName", "Lime"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "LegalCopyright", "Copyright (C) 2026"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END